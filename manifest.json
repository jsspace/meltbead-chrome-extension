{
  "manifest_version": 3,
  "name": "Meltbead – Web Image to Bead Pattern",
  "version": "0.1.2",
  "description": "Right-click a webpage image to preview a fuse bead grid, match real bead color codes, and export a materials list.",
  "permissions": ["contextMenus", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open Meltbead web image tool",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
